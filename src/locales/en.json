    },
    "vision": {
      "title": "Our Vision",
      "description": "By 2030, KhmerHR will be the platform where 1 million Cambodians find formal employment annually. We envision a Cambodia where every worker has a digital identity, every employer finds talent effortlessly, and the gap between informal and formal work is closed.",
      "stat": "Population under 30: 65% — the time to act is now."
    },
